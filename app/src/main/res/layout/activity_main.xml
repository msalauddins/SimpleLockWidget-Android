<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_android17"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/banking_safe_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_android17"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:text="@string/banking_safe_badge"
            android:textColor="#6EE7B7"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="#F0F6FC"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/status_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="Zero Accessibility permissions. Financial &amp; banking apps will never show a warning."
            android:textAlignment="center"
            android:textColor="#8B949E"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/enabled_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:minHeight="48dp"
            android:text="Screen Lock Permission"
            android:textColor="#E6EDF3"
            android:textSize="15sp" />

        <Button
            android:id="@+id/lock_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary_android17"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/lock_screen_now"
            android:textAllCaps="false"
            android:textColor="#002635"
            android:textSize="16sp" />

        <Button
            android:id="@+id/add_widget_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_tonal_android17"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/add_widget_home"
            android:textAllCaps="false"
            android:textColor="#BAE6FD"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Design and Develop by Md Salauddin\nsalauddin.cmt@gmail.com"
        android:textAlignment="center"
        android:textColor="#6E7681"
        android:textSize="12sp" />

</LinearLayout>
